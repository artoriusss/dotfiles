(defcfg
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd
  process-unmapped-keys yes 
)

;; 1. Expand defsrc to visualize your whole grid
;; tab/caps play the role of cleo's outer-left column (esc/tab positions).
(defsrc
  tab  q   w   e   r   t   y   u   i   o   p   bspc
  caps a   s   d   f   g   h   j   k   l   scln '
  z   x   c   v   b   n   m   ,   .   /
  lalt ralt
)

;; Mirrors the QMK boards: TAPPING_TERM 200 + FLOW_TAP_TERM 150.
;; The switch replicates QMK Flow Tap: a home-row key pressed within 150ms
;; of the previous (non-modifier) keystroke resolves as plain tap instantly,
;; so mods never fire mid-word. The modifier exclusion keeps staggered mod
;; chords (e.g. hold ctrl, then add shift) working, like QMK's flow-tap does.
(deftemplate hrm (key mod)
  (switch
    ((and
       (key-timing 1 less-than 150)
       (not (key-history lsft 1) (key-history rsft 1)
            (key-history lctl 1) (key-history rctl 1)
            (key-history lalt 1) (key-history ralt 1)
            (key-history lmet 1) (key-history rmet 1))))
      $key break
    () (tap-hold 200 200 $key $mod) break
  )
)

(defalias
  a (t! hrm a lmet)
  s (t! hrm s lalt)
  d (t! hrm d lsft)
  f (t! hrm f lctl)

  j (t! hrm j rctl)
  k (t! hrm k rsft)
  l (t! hrm l lalt)
  scln (t! hrm scln lmet)

  ;; Rover home-row digits keep the same mods as the letters under them,
  ;; matching cleo's R_HM_* keys.
  1 (t! hrm 1 lmet)
  2 (t! hrm 2 lalt)
  3 (t! hrm 3 lsft)
  4 (t! hrm 4 lctl)
  7 (t! hrm 7 rctl)
  8 (t! hrm 8 rsft)
  9 (t! hrm 9 lalt)
  0 (t! hrm 0 lmet)

  nav (tap-hold 200 200 lalt (layer-toggle navig))
  rov (tap-hold 200 200 ralt (layer-toggle rover))
)

;; 2. Default layer matches defsrc but injects your aliases
(deflayer default
  tab  q   w   e   r   t   y   u   i   o   p   bspc
  caps @a  @s  @d  @f  g   h   @j  @k  @l  @scln '
  z   x   c   v   b   n   m   ,   .   /
  @nav @rov
)

;; The underscores (_) fall back to standard letters so HRMs still work!
(deflayer navig
  _ C-pgup _  _ C-pgdn  _   _ S-M-left  pgup   pgdn S-M-right del
  _ _      _  _      _  _ M-left  left     up   down     right M-right
  _      _ C-S-c C-S-v  _   _ C-left   A-up A-down   C-right
  _ _
)

;; Cleo's _ROVER layer: symbols on top, digits with home-row mods, math row.
(deflayer rover
  grv    S-1  S-2  S-3  S-4  S-5   S-6  S-7  S-8  S-9  S-0  bspc
  S-\    @1   @2   @3   @4   5     6    @7   @8   @9   @0   \
  XX   XX   XX   S-min eql   S-eql min  ,    .    /
  _ _
)
