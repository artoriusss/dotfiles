{
    // Ported from .config/kglobalshortcutsrc (KDE/KWin).
    // Merge rule: cosmic-comp does defaults.extend(custom), and Binding's
    // Hash/PartialEq ignore `description`, so an entry here silently replaces
    // the same combo in /usr/share/cosmic/.../v1/defaults. `Disable` removes
    // a default outright.
    //
    // Keys are xkb keysyms, resolved through the active layout. Under Colemak
    // the keysym -> physical mapping is: a=a r=s s=d t=f f=e e=k l=u v=v.
    // So Super+a/r/s/t is the left home row, exactly as in KDE.

    // ---- Workspaces: Colemak home row (was Meta+A/R/S/T -> Desktop 1-4) ----
    (modifiers: [Super], key: "a", description: "Workspace 1"): Workspace(1),
    (modifiers: [Super], key: "r", description: "Workspace 2"): Workspace(2),
    (modifiers: [Super], key: "s", description: "Workspace 3"): Workspace(3),
    (modifiers: [Super], key: "t", description: "Workspace 4"): Workspace(4),

    // New: KDE had no window-to-desktop on the home row. Free, so take it.
    (modifiers: [Super, Shift], key: "a"): MoveToWorkspace(1),
    (modifiers: [Super, Shift], key: "r"): MoveToWorkspace(2),
    (modifiers: [Super, Shift], key: "s"): MoveToWorkspace(3),
    (modifiers: [Super, Shift], key: "t"): MoveToWorkspace(4),

    // kanata navig layer, physical u / p, emits S-M-left / S-M-right.
    // In KDE that was "Switch One Desktop Left/Right"; COSMIC defaults it to
    // Move(Left)/Move(Right), so repoint it here rather than editing kanata.
    (modifiers: [Super, Shift], key: "Left"): PreviousWorkspace,
    (modifiers: [Super, Shift], key: "Right"): NextWorkspace,

    // ---- Window ----
    (modifiers: [Super], key: "f"): Fullscreen,        // was Meta+F; overrides HomeFolder
    (modifiers: [Super], key: "Prior"): Maximize,      // was Meta+PgUp
    (modifiers: [Super], key: "Next"): Minimize,       // was Meta+PgDown
    (modifiers: [Super], key: "F4"): Close,            // was Meta+F4 (Super+q / Alt+F4 still work)

    // ---- Session ----
    (modifiers: [Super], key: "l"): System(LockScreen),      // was Meta+L; overrides Focus(Right)
    (modifiers: [Ctrl, Alt], key: "Delete"): System(LogOut), // was Ctrl+Alt+Del

    // ---- Launchers ----
    // cosmic-comp runs Spawn through `/bin/sh -c`, so quoting and ~ work.
    (modifiers: [Alt], key: "space"): Spawn("vicinae toggle"),
    (modifiers: [Ctrl, Alt], key: "t"): Spawn("ghostty"),
    (modifiers: [Super], key: "e"): System(HomeFolder),      // was Meta+E (Dolphin)
    (modifiers: [Super], key: "v"): Spawn("vicinae deeplink 'vicinae://launch/clipboard/history'"),
    (modifiers: [Super], key: "period"): Spawn("vicinae deeplink 'vicinae://launch/vicinae/search-emojis'"),

    // ---- Screenshot ----
    // Print stays System(Screenshot) (interactive picker: region/window/screen).
    // Shift+Print was "Capture Entire Desktop" in KDE -> non-interactive grab.
    (modifiers: [Shift], key: "Print"): Spawn("cosmic-screenshot --interactive=false --save-dir ~/Pictures/Screenshots"),

    // ---- Disable COSMIC's vim-letter duplicates ----
    // These assume QWERTY. Under Colemak the keysyms h/j/k/l land on physical
    // h/y/n/u, i.e. no cluster at all. The arrow variants stay, and kanata's
    // navig layer already produces arrows.
    (modifiers: [Super], key: "h"): Disable,
    (modifiers: [Super], key: "j"): Disable,
    (modifiers: [Super], key: "k"): Disable,
    (modifiers: [Super, Shift], key: "h"): Disable,
    (modifiers: [Super, Shift], key: "j"): Disable,
    (modifiers: [Super, Shift], key: "k"): Disable,
    (modifiers: [Super, Shift], key: "l"): Disable,
    (modifiers: [Super, Ctrl], key: "h"): Disable,
    (modifiers: [Super, Ctrl], key: "j"): Disable,
    (modifiers: [Super, Ctrl], key: "k"): Disable,
    (modifiers: [Super, Ctrl], key: "l"): Disable,
    (modifiers: [Super, Shift, Ctrl], key: "h"): Disable,
    (modifiers: [Super, Shift, Ctrl], key: "j"): Disable,
    (modifiers: [Super, Shift, Ctrl], key: "k"): Disable,
    (modifiers: [Super, Shift, Ctrl], key: "l"): Disable,
    (modifiers: [Super, Alt], key: "h"): Disable,
    (modifiers: [Super, Alt], key: "j"): Disable,
    (modifiers: [Super, Alt], key: "k"): Disable,
    (modifiers: [Super, Alt], key: "l"): Disable,
    (modifiers: [Super, Shift, Alt], key: "h"): Disable,
    (modifiers: [Super, Shift, Alt], key: "j"): Disable,
    (modifiers: [Super, Shift, Alt], key: "k"): Disable,
    (modifiers: [Super, Shift, Alt], key: "l"): Disable,
}
