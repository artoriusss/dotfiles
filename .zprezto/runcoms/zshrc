if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats '%b'
zstyle ':vcs_info:git:*' actionformats '%b|%a'

_prompt_render() {
  vcs_info
  local git_seg=""
  if [[ -n $vcs_info_msg_0_ ]]; then
    git_seg=" on %B%F{magenta}${vcs_info_msg_0_//\%/%%}%f%b"
  fi
  PROMPT="%B%F{cyan}%3~%f%b${git_seg}"$'\n'"%(?.%B%F{green}>%f%b.%B%F{red}>%f%b) "
}
add-zsh-hook precmd _prompt_render

export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

alias datalogtool="$HOME/Luftronix-daily/ubuntu/DataLogTool"
alias logviewer="$HOME/Luftronix-daily/ubuntu/LogViewer-x86_64.AppImage"
alias mltunnels="$HOME/Scripts/ml-tunnels.sh"

function sesh-sessions() {
  {
    exec </dev/tty
    exec <&1
    local session

    session=$(tv sesh > /dev/tty)

    zle reset-prompt > /dev/null 2>&1 || true
    [[ -z "$session" ]] && return
    sesh connect $session
  }
}

zle     -N             sesh-sessions
bindkey -M emacs '\es' sesh-sessions
bindkey -M vicmd '\es' sesh-sessions
bindkey -M viins '\es' sesh-sessions

# history-substring-search binds arrows via $terminfo[kcuu1] (\eOA, application
# keypad mode). Returning from tmux leaves the terminal in normal keypad mode,
# where arrows send \e[A and fall back to plain history. Bind both modes so the
# substring search works regardless of keypad state.
for keymap in emacs viins; do
  bindkey -M $keymap '^[[A' history-substring-search-up
  bindkey -M $keymap '^[[B' history-substring-search-down
  bindkey -M $keymap '^[OA' history-substring-search-up
  bindkey -M $keymap '^[OB' history-substring-search-down
done
unset keymap

eval "$(zoxide init --cmd cd zsh)"
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fpath+=${ZDOTDIR:-~}/.zsh_functions

