#!/usr/bin/env bash
# Track real-workspace history, ignoring technical (_*) workspaces.
# Runs from the workspace-history plugin on every workspace focus event.
# State file holds two lines:  active_real \n last_real

set -euo pipefail

state="${XDG_RUNTIME_DIR:-/tmp}/herdr-workspace-history"

# Debug aid: record every event this hook ever sees.
if [[ -n ${HERDR_WORKSPACE_HISTORY_DEBUG:-} ]]; then
    printf '%s %s\n' "${HERDR_PLUGIN_EVENT:-?}" "${HERDR_PLUGIN_EVENT_JSON:-}" \
        >> "${XDG_RUNTIME_DIR:-/tmp}/herdr-workspace-history.log"
fi

ws=${HERDR_WORKSPACE_ID:-}
[[ -z $ws ]] && ws=$(jq -r '.. | objects | .workspace_id? // empty' <<<"${HERDR_PLUGIN_EVENT_JSON:-{}}" | head -1)
[[ -z $ws ]] && exit 0

label=$(herdr workspace get "$ws" 2>/dev/null | jq -r '.result.workspace.label // empty')
case "$label" in
    _*) exit 0 ;;   # technical workspace: leave history untouched
esac

active=$(sed -n 1p "$state" 2>/dev/null || true)
last=$(sed -n 2p "$state" 2>/dev/null || true)

if [[ $active == "$ws" ]]; then
    exit 0
fi

[[ -n $active ]] && last=$active
printf '%s\n%s\n' "$ws" "$last" > "$state"
