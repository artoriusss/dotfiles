#!/usr/bin/env bash
# Stamp flight-log dir mtimes from the timestamp baked into their names, so
# sorting by modification time == sorting by flight time.
#
# Log dirs are named NNNN-YYYYMMDD-HHMMSS. The leading NNNN is a per-drone
# sequence counter, so plain name sort interleaves flights from different
# drones and different months. The real mtime is just when the dir was copied
# off the SD card, which is equally useless. This rewrites mtime to the name's
# timestamp; after that `ls -t`, fzf, and yazi's sort-by-modified all agree.
#
#   flightlog-mtime [-n] [DIR...]     default DIR is .
#     -n   dry run, print what would change
#
# Safe to re-run; only touches dirs whose mtime is already wrong.

set -euo pipefail

dry=0
if [[ ${1-} == -n ]]; then dry=1; shift; fi
(($#)) || set -- .

changed=0 skipped=0
for root; do
	for dir in "$root"/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]/; do
		dir=${dir%/}
		[[ -d $dir ]] || continue

		name=${dir##*/}
		date=${name:5:8} time=${name:14:6}
		stamp="${date:0:4}-${date:4:2}-${date:6:2} ${time:0:2}:${time:2:2}:${time:4:2}"

		want=$(date -d "$stamp" +%s 2>/dev/null) || { echo "skip (bad date): $name" >&2; ((++skipped)); continue; }
		[[ $(stat -c %Y "$dir") == "$want" ]] && continue

		if ((dry)); then
			echo "would touch $name -> $stamp"
		else
			touch -d "@$want" "$dir"
		fi
		((++changed))
	done
done

((dry)) && echo "$changed dir(s) would change, $skipped skipped" \
        || echo "$changed dir(s) stamped, $skipped skipped"
