#!/usr/bin/env bash
# Start every herdr server launch from a clean slate.
#
# Herdr restores the workspaces and tabs it persisted in ~/.config/herdr/
# session.json unconditionally — there is no config key to turn that off, and
# the persisted state records only each pane's cwd, so a restored workspace is
# a row of dead tabs whose processes are gone. This runs from the
# session-bootstrap plugin's [[startup]] hook, which herdr fires after restore
# with the socket API already up, and puts the session back to what a
# first-ever launch would look like:
#
#   * one fresh ~ workspace, focused
#   * the technical _* workspaces, each with its command already running
#   * everything restore brought back, closed
#
# Usage: herdr-session-bootstrap                  reset the session now
#        herdr-session-bootstrap --on-startup     reset it unless this launch
#                                                 inherited a live session
#        herdr-session-bootstrap --ensure LABEL   create one technical
#                                                 workspace if it is missing,
#                                                 printing its id either way

set -euo pipefail

# The technical workspaces, in sidebar order: "<label>:<command>". The command
# may be empty for a plain shell. This is the only place they are defined;
# herdr-toggle-workspace creates them through --ensure.
technical=(
    "_fs:yazi"
    "_services:"
    "_monitor:htop"
)

die() { printf '%s\n' "$1" >&2; exit 1; }

command_for() {
    local entry
    for entry in "${technical[@]}"; do
        [[ ${entry%%:*} == "$1" ]] && { printf '%s' "${entry#*:}"; return 0; }
    done
    return 1
}

workspace_id() {
    herdr workspace list | jq -r --arg l "$1" '
        [.result.workspaces[] | select(.label == $l) | .workspace_id][0] // empty'
}

# ensure <label> — focus-neutral create; prints the workspace id.
ensure() {
    local label=$1 cmd id created
    cmd=$(command_for "$label") || die "unknown technical workspace: $label"

    id=$(workspace_id "$label")
    if [[ -n $id ]]; then
        printf '%s\n' "$id"
        return
    fi

    created=$(herdr workspace create --label "$label" --cwd "$HOME" --no-focus)
    if [[ -n $cmd ]]; then
        herdr pane run "$(jq -r '.result.root_pane.pane_id' <<<"$created")" "$cmd" >/dev/null
    fi
    jq -r '.result.workspace.workspace_id' <<<"$created"
}

# Field 22 of /proc/<pid>/stat, the process start time in ticks since boot.
# Parsed off the last ")" because a comm can contain spaces and parens.
starttime() {
    local stat
    stat=$(< "/proc/$1/stat") || return 1
    awk '{print $20}' <<<"${stat#*) }"
}

# `herdr update --handoff` restarts the server with the ptys still attached:
# the workspaces it brings back are a live session with live processes, not the
# corpse of one, and wiping it would throw away the user's work. Herdr runs
# plugin hooks as children of the server, so a pane whose shell predates our
# own parent was inherited rather than spawned by this launch.
#
# If herdr ever stops running hooks from the server, this reads some other,
# younger process and stops resetting — the session comes back dirty, which is
# the failure worth having.
handed_off() {
    local server pane shell t
    server=$(starttime "$PPID") || return 0

    for pane in $(herdr pane list | jq -r '.result.panes[].pane_id'); do
        shell=$(herdr pane process-info --pane "$pane" \
                | jq -r '.result.process_info.shell_pid // empty') || continue
        [[ -n $shell ]] || continue
        t=$(starttime "$shell") || continue
        (( t < server )) && return 0
    done
    return 1
}

reset() {
    local restored landing entry id

    mapfile -t restored < <(herdr workspace list | jq -r '.result.workspaces[].workspace_id')

    # Built before anything is closed, so there is always a workspace left to
    # hold focus — and so the fresh ones keep a sane sidebar order.
    landing=$(herdr workspace create --cwd "$HOME" --focus \
              | jq -r '.result.workspace.workspace_id')

    # Then drop the restored ones, technical labels included: a restored _fs is
    # an empty shell, not yazi, and `ensure` below would adopt it by label.
    for id in "${restored[@]}"; do
        herdr workspace close "$id" >/dev/null
    done

    for entry in "${technical[@]}"; do
        ensure "${entry%%:*}" >/dev/null
    done
    herdr workspace focus "$landing" >/dev/null

    # Workspace ids are reused, so history and toggle state written by the
    # previous server now name workspaces that no longer exist — or, worse,
    # different ones. XDG_RUNTIME_DIR survives a server restart even though it
    # does not survive a reboot.
    rm -f "${XDG_RUNTIME_DIR:-/tmp}/herdr-workspace-history"
    for entry in "${technical[@]}"; do
        rm -f "${XDG_RUNTIME_DIR:-/tmp}/herdr-toggle-${entry%%:*}"
    done
}

case ${1:-} in
    "")           reset ;;
    --on-startup) handed_off || reset ;;
    --ensure)     shift; ensure "${1:-}" ;;
    *)            die "usage: ${0##*/} [--on-startup | --ensure LABEL]" ;;
esac
