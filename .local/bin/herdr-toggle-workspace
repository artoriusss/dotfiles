#!/usr/bin/env bash
# Toggle a technical workspace by label, tmux-style:
#   already there -> jump back to the workspace we came from
#   elsewhere     -> focus it, creating it (and running its command) if missing
#
# Usage: herdr-toggle-workspace <label>

set -euo pipefail

label=$1
state="${XDG_RUNTIME_DIR:-/tmp}/herdr-toggle-$label"

# One `herdr` call and one `jq` call on the hot path: this runs on a keypress.
read -r current target < <(
    herdr workspace list | jq -r --arg l "$label" '
        ([.result.workspaces[]|select(.focused)|.workspace_id][0] // "-") + " " +
        ([.result.workspaces[]|select(.label==$l)|.workspace_id][0] // "-")'
)

if [[ $target != "-" && $current == "$target" ]]; then
    back=$(cat "$state" 2>/dev/null || true)
    [[ -n $back ]] && herdr workspace focus "$back" >/dev/null
    exit 0
fi

printf '%s' "$current" > "$state"

# Cold path only: session-bootstrap already built these at server launch, so
# this fires when one has been closed by hand. It owns the label -> command
# table, so the command lives in exactly one place.
[[ $target == "-" ]] && target=$(herdr-session-bootstrap --ensure "$label")

herdr workspace focus "$target" >/dev/null
